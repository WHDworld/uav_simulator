<?xml version="1.0"?>
<package format="2">
  <name>lidar_simulator</name>
  <version>1.0.0</version>
  <description>
    Livox Mid-360 LiDAR simulator for UAV simulation.
    Generates realistic non-repetitive scanning pattern point clouds from existing maps.
  </description>

  <maintainer email="user@example.com">User</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  
  <build_depend>roscpp</build_depend>
  <build_depend>roslib</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>pcl_conversions</build_depend>
  <build_depend>eigen</build_depend>
  
  <exec_depend>roscpp</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>

  <!-- Optional: Livox ROS driver for custom message support -->
  <!-- <exec_depend>livox_ros_driver2</exec_depend> -->

  <export>
  </export>
</package>

