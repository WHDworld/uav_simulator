Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Sensor Data1
        - /Sensor Data1/Depth Camera1
        - /Sensor Data1/LiDAR1
        - /Robot1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: LiDAR Pointcloud
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/Group
          Displays:
            - Class: rviz/Image
              Enabled: true
              Image Topic: /uav_simulator/depth_image
              Max Value: 10
              Median window: 5
              Min Value: 0
              Name: Depth Image
              Normalize Range: true
              Queue Size: 2
              Transport Hint: raw
              Unreliable: false
              Value: true
            - Class: rviz/Image
              Enabled: true
              Image Topic: /uav_simulator/rgb_image
              Max Value: 1
              Median window: 5
              Min Value: 0
              Name: RGB Image
              Normalize Range: true
              Queue Size: 2
              Transport Hint: raw
              Unreliable: false
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 239; 41; 41
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Min Color: 0; 0; 0
              Name: Depth Pointcloud
              Position Transformer: XYZ
              Queue Size: 10
              Selectable: true
              Size (Pixels): 8
              Size (m): 0.10000000149011612
              Style: Boxes
              Topic: /depth_pointcloud
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: false
              Value: true
          Enabled: true
          Name: Depth Camera
        - Class: rviz/Group
          Displays:
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 3.0
                Min Value: 0.0
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 52; 101; 164
              Color Transformer: Intensity
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Min Color: 0; 0; 0
              Name: LiDAR Pointcloud
              Position Transformer: XYZ
              Queue Size: 10
              Selectable: true
              Size (Pixels): 2
              Size (m): 0.019999999552965164
              Style: Points
              Topic: /livox/lidar
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 2.4000000953674316
                Min Value: -0.5
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 136; 138; 133
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Min Color: 0; 0; 0
              Name: Map Reference
              Position Transformer: XYZ
              Queue Size: 1
              Selectable: false
              Size (Pixels): 2
              Size (m): 0.10000000149011612
              Style: Boxes
              Topic: /lidar/map
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: false
              Value: true
          Enabled: true
          Name: LiDAR
      Enabled: true
      Name: Sensor Data
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /odom_visualization/robot
          Name: Robot Mesh
          Namespaces:
            mesh: true
          Queue Size: 100
          Value: true
        - Alpha: 1
          Axes Length: 0.5
          Axes Radius: 0.10000000149011612
          Class: rviz/Pose
          Color: 255; 25; 0
          Enabled: true
          Head Length: 0.15000000596046448
          Head Radius: 0.07999999821186066
          Name: Robot Pose
          Queue Size: 10
          Shaft Length: 0.30000001192092896
          Shaft Radius: 0.03999999910593033
          Shape: Axes
          Topic: /odom_visualization/pose
          Unreliable: false
          Value: true
        - Angle Tolerance: 0.10000000149011612
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.30000001192092896
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 100
          Name: Odometry Trail
          Position Tolerance: 0.10000000149011612
          Queue Size: 10
          Shape:
            Alpha: 1
            Axes Length: 0.30000001192092896
            Axes Radius: 0.05000000074505806
            Color: 255; 85; 0
            Head Length: 0.10000000149011612
            Head Radius: 0.05000000074505806
            Shaft Length: 0.20000000298023224
            Shaft Radius: 0.029999999329447746
            Value: Arrow
          Topic: /uav_simulator/odometry
          Unreliable: false
          Value: true
      Enabled: true
      Name: Robot
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/position_cmd_vis
          Name: Position Command
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/travel_traj
          Name: Trajectory
          Namespaces:
            {}
          Queue Size: 100
          Value: true
      Enabled: true
      Name: Control
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/ThirdPersonFollower
      Distance: 26.667516708374023
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: -4.2150726318359375
        Y: 0.5454658269882202
        Z: -1.430511474609375e-06
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.9150002598762512
      Target Frame: <Fixed Frame>
      Yaw: 2.7699992656707764
    Saved:
      - Class: rviz/ThirdPersonFollower
        Distance: 24
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Field of View: 0.7853981852531433
        Focal Point:
          X: -6
          Y: 0
          Z: 0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05000000074505806
        Invert Z Axis: false
        Name: classical_office
        Near Clip Distance: 0.009999999776482582
        Pitch: 1.2000000476837158
        Target Frame: <Fixed Frame>
        Yaw: 3.140000104904175
      - Class: rviz/Orbit
        Distance: 20
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Field of View: 0.7853981852531433
        Focal Point:
          X: 0
          Y: 0
          Z: 1
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05000000074505806
        Invert Z Axis: false
        Name: Top Down
        Near Clip Distance: 0.009999999776482582
        Pitch: 1.5697963237762451
        Target Frame: <Fixed Frame>
        Yaw: 0
Window Geometry:
  Depth Image:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 0

